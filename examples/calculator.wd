# Simple calculator in lib-binary
# Demonstrates user input and arithmetic operations

func add(a, b):
    return a + b

func subtract(a, b):
    return a - b

func multiply(a, b):
    return a * b

func divide(a, b):
    if b == 0:
        print("Error: Division by zero!")
        return 0
    return a / b

func main():
    print("=== Simple Calculator ===")
    print("Enter two numbers and an operation")
    
    # Get user input
    print("Enter first number:")
    num1_str = input()
    num1 = cast_int(num1_str)
    
    print("Enter second number:")
    num2_str = input()
    num2 = cast_int(num2_str)
    
    print("Enter operation (+, -, *, /):")
    op = input()
    
    # Perform calculation
    if op == "+":
        result = add(num1, num2)
        print(num1, "+", num2, "=", result)
    elif op == "-":
        result = subtract(num1, num2)
        print(num1, "-", num2, "=", result)
    elif op == "*":
        result = multiply(num1, num2)
        print(num1, "*", num2, "=", result)
    elif op == "/":
        result = divide(num1, num2)
        print(num1, "/", num2, "=", result)
    else:
        print("Unknown operation:", op)
        result = 0
    
    return result
